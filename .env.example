# Steel.dev — required for real isolated browser sessions.
STEEL_API_KEY=

# OpenAI — optional but recommended for autonomous source discovery and evidence synthesis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# VirusTotal — optional; enables the URL threat-intelligence scanner in SignalShield.
VIRUSTOTAL_API_KEY=

# Optional Steel lifecycle tuning (milliseconds).
STEEL_SESSION_TIMEOUT_MS=600000
STEEL_INACTIVITY_TIMEOUT_MS=180000

# Optional: override Steel API base URL for self-hosting/testing.
# STEEL_API_URL=https://api.steel.dev/v1
